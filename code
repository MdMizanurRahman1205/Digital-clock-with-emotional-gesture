    display.display();
    delay(FRAME_DELAY);
  }
}




// ---------- Setup ----------
void setup() {
  Serial.begin(115200);

  pinMode(TOUCH_PIN, INPUT);
  pinMode(Buzzer, OUTPUT);

  // Reset button as input pullup
  pinMode(RESET_BUTTON, INPUT_PULLUP);

  dht.begin();

  if (!display.begin(SSD1306_SWITCHCAPVCC, 0x3C)) {
    Serial.println("SSD1306 allocation failed");
    for (;;);
  }

  display.clearDisplay();
  display.setTextSize(1);
  display.setTextColor(SSD1306_WHITE);
  display.setCursor(0, 0);
  display.println("Initializing...");
  display.display();

  // Read saved WiFi from EEPROM
  loadCredentials();

  // If no saved WiFi → start portal
  if (ssidSaved == "") {
    Serial.println("No saved WiFi credentials.");
    showWiFiPortalMessage();
    shouldStartPortal = true;
  } else {
    // Try connecting to saved WiFi
    Serial.println("Connecting to saved WiFi...");
    display.clearDisplay();
    display.setCursor(0,0);
    display.println("Connecting WiFi...");
    display.display();

    WiFi.begin(ssidSaved.c_str(), passSaved.c_str());

    unsigned long startAttempt = millis();
    while (WiFi.status() != WL_CONNECTED && millis() - startAttempt < 7000) {
      delay(500);
      Serial.print(".");
      display.print(".");
      display.display();
    }

    if (WiFi.status() != WL_CONNECTED) {
      Serial.println("\nFailed to connect to saved WiFi!");
      showWiFiPortalMessage();

      shouldStartPortal = true;
    } else {
      Serial.println("\nWiFi Connected: ");
      Serial.println(WiFi.localIP());
      display.clearDisplay();
      display.setCursor(0,0);
      display.println("WiFi Connected!");
      display.display();
      delay(800);
      // configure time only if WiFi connected
      // On ESP8266: configTime exists; daylightOffset_sec may be unused but pass it
      configTime(gmtOffset_sec, daylightOffset_sec, ntpServer);
      showWelcomeAnimation();
    }
  }

  if (shouldStartPortal) {
    startConfigPortal();
  }
}

// ---------- Loop ----------
void loop() {
  unsigned long now = millis();
  bool pressed = isPressed();

  // Handle long-press reset button (5 seconds)
  static unsigned long pressStart = 0;
  static bool buttonPressed = false;
  if (digitalRead(RESET_BUTTON) == LOW) {
    if (!buttonPressed) {
      pressStart = millis();
      buttonPressed = true;
    }
    if (buttonPressed && millis() - pressStart > 5000) {
      Serial.println("Reset Button Hold → Opening WiFi Portal");
      shouldStartPortal = true;
      if (!portalActive) startConfigPortal();
    }
  } else {
    buttonPressed = false;
  }

  // If portal active, let it handle clients
  if (portalActive) {
    server.handleClient();
    // While portal is active we do not run the rest of the clock loop
    delay(10);
    return;
  }

  // Normal clock touch logic
  if (pressed && !touchActive) {
    if (now - lastTouchMillis > DEBOUNCE_MS) {
      touchActive = true;
      touchStartMillis = now;
      lastTouchMillis = now;
      displayingAnimation = false;
      currentStage = 0;
    }
  }

  if (!pressed && touchActive) {
    touchActive = false;
    unsigned long releaseTime = now;
    unsigned long held = releaseTime - touchStartMillis;
    Serial.print("Held: "); Serial.print(held);
    Serial.print("  Gap: "); Serial.println(releaseTime - lastReleaseTime);

    displayingAnimation = false;
    currentStage = 0;

    if ((releaseTime - lastReleaseTime) < 800000 && held < 1000) {
      is12HourFormat = !is12HourFormat;
      digitalWrite(Buzzer, HIGH);
      delay(300);
      digitalWrite(Buzzer, LOW);
      display.clearDisplay();
      display.setTextSize(1);
      display.setCursor(20, 28);
      display.println(is12HourFormat ? "12-Hour Format" : "24-Hour Format");
      display.display();
      delay(1000);
      lastReleaseTime = 0;
    } else {
      lastReleaseTime = releaseTime;
    }
  }

  if (touchActive) {
    unsigned long held = now - touchStartMillis;
    int stage = getTouchStage(held);

    if (stage != 0 && stage != currentStage) {
      displayingAnimation = true;
      currentStage = stage;

      switch (stage) {
        case 1:
          playAnimation(frames1, sizeof(frames1)/sizeof(frames1[0]));
          break;
        case 2:
          playAnimation(frames2, sizeof(frames2)/sizeof(frames2[0]));
          break;
        case 3:
          playAnimation(frames3, sizeof(frames3)/sizeof(frames3[0]));
          break;
        case 4:
          displayingAnimation = true;
          enterSleepMode();
          return;
      }
    }
  }

  // If not showing animations, show clock
  if (!displayingAnimation) {
    struct tm timeinfo;
    if (!getTimeNow(timeinfo)) {
      // time not available; skip showing clock (you may attempt retry)
      delay(200);
      return;
    }
    float temp = dht.readTemperature();
    float hum = dht.readHumidity();
    showClockAndSensors(timeinfo, temp, hum);
  }

  // Keep handling server clients in case portal gets started by button while running
  if (portalActive) server.handleClient();

  delay(200);
}

