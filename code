// ---------- EEPROM (Preferences) FUNCTIONS ----------
void saveCredentials(const String &ssid, const String &pass) {
  EEPROM.begin(512);
  // Clear a region first
  for (int i = 0; i < 200; i++) EEPROM.write(i, 0);

  int sLen = ssid.length();
  int pLen = pass.length();
  if (sLen > 64) sLen = 64; // limit
  if (pLen > 128) pLen = 128;

  EEPROM.write(0, sLen);
  for (int i = 0; i < sLen; i++) EEPROM.write(1 + i, ssid[i]);

  EEPROM.write(70, pLen);
  for (int i = 0; i < pLen; i++) EEPROM.write(71 + i, pass[i]);

  EEPROM.commit();
}

void loadCredentials() {
  EEPROM.begin(512);
  ssidSaved = "";
  passSaved = "";

  int sLen = EEPROM.read(0);
  if (sLen > 0 && sLen <= 64) {
    for (int i = 0; i < sLen; i++) {
      char c = EEPROM.read(1 + i);
      if (c) ssidSaved += c;
    }
  }

  int pLen = EEPROM.read(70);
  if (pLen > 0 && pLen <= 128) {
    for (int i = 0; i < pLen; i++) {
      char c = EEPROM.read(71 + i);
      if (c) passSaved += c;
    }
  }
}

